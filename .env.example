# TCE Admin Environment Configuration
# Copy this to .env and fill in your values

# Flask configuration
FLASK_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///tce_admin.db

# Emergency fallback login (use a long, unique production password)
SUPER_ADMIN_USERNAME=tceadmin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-random-password

# HANA Database credentials (for datasource sync)
HANA_HOST=hana.uky.edu
HANA_PORT=30015
HANA_USER=HANA_EXPLORANCE_USER
HANA_PASSWORD=your-password-here
